# Copy to .env and fill in your own values

# Flask
SECRET_KEY=change-me
FLASK_ENV=development

# Redis (broker, result backend and cache)
REDIS_URL=redis://localhost:6379/0

# Email - Mailtrap sandbox credentials (https://mailtrap.io/inboxes)
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=HMS <noreply@hospital.com>

# Google Chat webhook for daily reminders (optional)
GOOGLE_CHAT_WEBHOOK_URL=
